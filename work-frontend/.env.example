# ─────────────────────────────────────────────────────
# Freight Forecasting Frontend — environment variables
# Copy this file to .env and adjust as needed.
# ─────────────────────────────────────────────────────

# Set to "true" to use the bundled mock response (no backend required).
# Set to "false" to send real requests to VITE_API_BASE.
VITE_USE_MOCK=true

# Base URL of the Member 4 FastAPI backend.
# Only used when VITE_USE_MOCK=false.
VITE_API_BASE=http://localhost:8000
